#!/usr/bin/env bash
# ccenv — switch between multiple Claude Code accounts, securely & concurrently.
#
# Model:
#   A "profile" is an isolated Claude Code config directory (CLAUDE_CONFIG_DIR).
#   Claude Code stores each config dir's OAuth credentials in their OWN entry of
#   the OS credential store (macOS Keychain, or a per-profile credentials file on
#   Linux/Windows), so different shells pointed at different profiles run
#   different accounts AT THE SAME TIME without clobbering each other.
#
#   ccenv never reads, writes, or stores raw tokens. Authentication is done
#   entirely through `claude auth {login,logout,status}`, which keeps secrets in
#   that store. The profile directory holds only non-secret config/state, most of
#   it symlinked from your real ~/.claude so every account keeps your full
#   plugin/skill/command setup.
#
#   The special profile "default" is your existing ~/.claude (no override).
#   Runs on macOS, Linux, and Windows (via Git Bash or WSL).
#
# Usage: ccenv help
set -uo pipefail

CCENV_VERSION="1.7.3"

# ---- paths -------------------------------------------------------------------
CCENV_HOME="${CCENV_HOME:-$HOME/.ccenv}"

# Normalize away trailing slashes BEFORE validating: "$HOME//" would otherwise
# slip past the case guard below (? matches / inside a case pattern) and
# "link/" past the -L check (test follows a trailing-slash symlink) — either
# could aim rm -rf somewhere catastrophic.
while [ "${CCENV_HOME%/}" != "$CCENV_HOME" ]; do CCENV_HOME="${CCENV_HOME%/}"; done

# Safety guard: CCENV_HOME backs rm -rf (cmd_remove, uninstall --purge), so a
# stray/hostile value (/, $HOME, a path with .., or a symlink) must never get
# there. Require a real path strictly under $HOME with no traversal.
case "$CCENV_HOME" in
  *..*)        printf 'ccenv: refusing CCENV_HOME with "..": %s\n' "$CCENV_HOME" >&2; exit 1 ;;
  "$HOME"/?*)  : ;;
  *)           printf 'ccenv: refusing unsafe CCENV_HOME=%s (must be a dir under %s)\n' "$CCENV_HOME" "$HOME" >&2; exit 1 ;;
esac
if [ -L "$CCENV_HOME" ]; then
  printf 'ccenv: CCENV_HOME is a symlink — refusing: %s\n' "$CCENV_HOME" >&2; exit 1
fi

PROFILES_DIR="$CCENV_HOME/profiles"
BASE_CONFIG="${CCENV_BASE_CONFIG:-$HOME/.claude}"

# Standing default profile: the name in this file is auto-applied by the shell
# integration to every new shell that hasn't already picked a profile. Name
# only — no secrets. Kept inside the path-guarded CCENV_HOME.
DEFAULT_FILE="$CCENV_HOME/default"

# Directory pins: "<canonical-abs-path>\t<profile>" per line. A new shell whose
# cwd is at or under a pinned path auto-applies that profile (nearest pin wins),
# overriding the standing default. Name only — no secrets. Guarded under
# CCENV_HOME like DEFAULT_FILE. See cmd_pin / cmd_resolve_auto.
PINS_FILE="$CCENV_HOME/pins"

# Cache for the "update available" notice: "<checked_epoch>\t<latest_version>".
# Refreshed at most once/24h by a detached background check (never on the shell-
# startup path); the visible commands just read it. Opt out with
# CCENV_NO_UPDATE_CHECK=1.
UPDATE_CACHE="$CCENV_HOME/.update-check"

# How a new profile inherits your environment:
#
#   SYMLINK (shared, read-mostly): heavy assets Claude Code loads at startup and
#   does not rewrite in a racy way. Sharing them means every account has your
#   plugins/skills/commands without duplication.
#
#   COPY (per-profile, independent): the small config files Claude Code DOES
#   rewrite at runtime (model choice, "always allow" permissions, MCP servers).
#   Copying — not symlinking — means two accounts running at the same time can
#   never race on or clobber each other's settings, and each account may diverge
#   (different model/permissions). Refresh from base later with `ccenv sync`.
#
# Everything else (sessions, projects, history, statsig, credentials) is created
# fresh per profile, which is what makes concurrent sessions isolated.
SHARED_SYMLINK=(plugins skills commands hooks CLAUDE.md)
SHARED_COPY=(settings.json settings.local.json mcp_config.json)

umask 077

# ---- colors ------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; X=$'\033[0m'
else
  B=""; D=""; R=""; G=""; Y=""; C=""; X=""
fi

# ---- output helpers ----------------------------------------------------------
err()  { printf '%sccenv:%s %s\n' "$R" "$X" "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$X" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$X" "$*"; }

# Portable octal file mode. Gate on uname — on GNU stat, `-f` means
# --file-system and would pollute the captured output instead of failing clean.
file_mode() {
  case "$(uname -s 2>/dev/null)" in
    Darwin|*BSD*) stat -f '%Lp' "$1" 2>/dev/null ;;
    *)            stat -c '%a'  "$1" 2>/dev/null ;;
  esac
}

# Download a URL to a file with curl or wget (used by `ccenv update`).
fetch() { # url dest
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else err "need curl or wget to reach the network"; return 1; fi
}

# ---- profile model -----------------------------------------------------------
validate_name() {
  local n="${1:-}"
  [ -n "$n" ] || { err "profile name required"; return 1; }
  # Single-pass allowlist via `case`. `grep -qE '^...$'` anchors PER LINE, so a
  # newline-containing name whose first line is clean would slip through (the
  # keychain path / dir name then holds a control char); `*[!set]*` rejects a
  # newline or any out-of-charset byte anywhere in the string.
  case "$n" in
    */*|.|..)          err "invalid profile name: $n"; return 1 ;;
    *[!A-Za-z0-9._-]*) err "invalid profile name '$n' (use letters, digits, . _ -)"; return 1 ;;
    [A-Za-z0-9]*)      return 0 ;;
    *)                 err "invalid profile name '$n' (must start with a letter or digit)"; return 1 ;;
  esac
}

is_default() { [ "${1:-}" = "default" ] || [ "${1:-}" = "main" ]; }

profile_dir() { printf '%s/%s' "$PROFILES_DIR" "$1"; }

# Echo the CLAUDE_CONFIG_DIR for a profile (empty string = default/~/.claude).
# Returns nonzero if the profile does not exist.
resolve_dir() {
  local n="${1:-}"
  validate_name "$n" || return 1
  if is_default "$n"; then printf ''; return 0; fi
  local d; d="$(profile_dir "$n")"
  if [ ! -d "$d" ]; then err "no such profile: $n  (try: ccenv create $n)"; return 1; fi
  printf '%s' "$d"
}

list_profiles() {
  printf 'default\n'
  if [ -d "$PROFILES_DIR" ]; then
    find "$PROFILES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort
  fi
}

# Print the standing default profile name (empty if none set). Reads only the
# first line and strips whitespace so a hand-edited file can't inject noise.
read_default() {
  [ -f "$DEFAULT_FILE" ] || return 0
  head -n1 "$DEFAULT_FILE" 2>/dev/null | tr -d '[:space:]'
}

# Atomically persist a validated profile name as the standing default.
write_default() {
  local name="$1" tmp
  mkdir -p "$CCENV_HOME" 2>/dev/null || true
  tmp="$(mktemp "$DEFAULT_FILE.XXXXXX")" || return 1
  printf '%s\n' "$name" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$DEFAULT_FILE" || { rm -f "$tmp"; return 1; }
}

# ---- directory pins ----------------------------------------------------------
# Canonicalize a directory to an absolute, symlink-resolved path so pins match
# regardless of how the user cd'd in. `cd + pwd -P` is portable (no realpath on
# stock macOS); mirrors the idiom in install.sh. Nonzero if not a real dir.
canon_dir() {
  local d="${1:-$PWD}" out
  [ -d "$d" ] || return 1
  # `cd --` so a dir named like an option (-L, -e, -) isn't parsed as a flag and
  # silently resolved to $HOME. CDPATH='' so a relative dir can't make `cd` jump
  # to a CDPATH entry and echo it to stdout, poisoning the captured path.
  out="$(CDPATH='' cd -- "$d" 2>/dev/null && pwd -P)" || return 1
  # A TAB or newline in the path would corrupt the tab-delimited, line-based
  # registry (and could forge extra rows). Refuse it — both when storing a pin
  # and when matching the cwd at shell startup.
  case "$out" in *$'\t'*|*$'\n'*) return 1 ;; esac
  printf '%s' "$out"
}

# Print the profile pinned to an EXACT canonical path (empty if none). TAB is a
# safe delimiter: validate_name forbids tabs in profile names.
pin_lookup() {
  [ -f "$PINS_FILE" ] || return 0
  awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$PINS_FILE" 2>/dev/null
}

# Print the profile of the NEAREST pinned ancestor of a canonical path — the pin
# whose path is the longest prefix of it on a path boundary (empty if none). One
# awk pass over the registry, so a new shell pays at most a single spawn.
nearest_pin() {
  [ -f "$PINS_FILE" ] || return 0
  awk -F'\t' -v s="$1" '
    $1 != "" && (s == $1 || index(s, $1 "/") == 1) {
      if (length($1) > blen) { blen = length($1); best = $2 }
    }
    END { if (blen) print best }
  ' "$PINS_FILE" 2>/dev/null
}

# Atomically rewrite the pins registry from stdin (mirror of write_default).
# An empty result deletes the file so the "no pins" fast path stays cheap.
write_pins() { # reads new content on stdin
  local tmp
  mkdir -p "$CCENV_HOME" 2>/dev/null || true
  tmp="$(mktemp "$PINS_FILE.XXXXXX")" || return 1
  cat > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true
  if [ -s "$tmp" ]; then
    mv "$tmp" "$PINS_FILE" || { rm -f "$tmp"; return 1; }
  else
    rm -f "$tmp" "$PINS_FILE"
  fi
}

# Run `claude auth status --json` for a config dir (empty = default/ambient-unset).
auth_status_json() {
  local dir="${1:-}"
  if [ -z "$dir" ]; then
    env -u CLAUDE_CONFIG_DIR claude auth status --json 2>/dev/null
  else
    env CLAUDE_CONFIG_DIR="$dir" claude auth status --json 2>/dev/null
  fi
}

# Extract one flat field from pretty-printed JSON (claude auth status is one
# key per line). Dependency-free. JSON null → empty string.
json_field() {
  local key="$1"
  grep -m1 "\"$key\"" | sed -E 's/.*: *//; s/^"//; s/",?$//; s/,$//; s/^null$//'
}

# True if a status blob looks like valid `claude auth status` output.
status_ok() {
  printf '%s' "$1" | grep -q '"loggedIn"'
}

# Populate a profile dir from a base config: symlink the heavy read-only assets,
# COPY the mutable config files (so concurrent accounts never race on them).
seed_profile() {
  local dir="$1" base="$2" asset
  for asset in "${SHARED_SYMLINK[@]}"; do
    if [ -e "$base/$asset" ] && [ ! -e "$dir/$asset" ]; then
      # Symlink where supported; fall back to a copy (e.g. Git Bash on Windows
      # without developer mode, where ln -s can't create real symlinks).
      ln -s "$base/$asset" "$dir/$asset" 2>/dev/null || cp -R "$base/$asset" "$dir/$asset"
    fi
  done
  for asset in "${SHARED_COPY[@]}"; do
    if [ -f "$base/$asset" ] && [ ! -e "$dir/$asset" ]; then
      cp "$base/$asset" "$dir/$asset"   # not -p: copy CONTENT, let umask 077 apply
      chmod 600 "$dir/$asset" 2>/dev/null || true
    fi
  done
}

# `claude auth login` stores valid credentials in the OS credential store but does
# NOT set hasCompletedOnboarding in <dir>/.claude.json — so the interactive TUI re-runs
# its onboarding/welcome flow (which looks like "log in again") even though auth
# is valid. Mark the profile onboarded so a switched session starts straight in.
mark_onboarded() {
  local dir="$1" f="$1/.claude.json"
  if command -v python3 >/dev/null 2>&1; then
    CC_F="$f" CC_BASE="$BASE_CONFIG/.claude.json" python3 - <<'PY' 2>/dev/null || true
import json, os
f = os.environ["CC_F"]; base = os.environ.get("CC_BASE", "")
try:    d = json.load(open(f)) if os.path.exists(f) else {}
except Exception: d = {}
d["hasCompletedOnboarding"] = True
try:
    b = json.load(open(base))
    for k in ("theme", "hasCompletedProjectOnboarding"):
        if k in b and k not in d: d[k] = b[k]
except Exception: pass
tmp = f + ".ccenv.tmp"
json.dump(d, open(tmp, "w"))
os.replace(tmp, f); os.chmod(f, 0o600)
PY
  else
    # No python3: portable JSON edit via awk + temp file (no GNU/BSD sed -i split).
    if [ -f "$f" ] && [ "$(tr -d ' \n\t' < "$f")" != "{}" ]; then
      if ! grep -q '"hasCompletedOnboarding"' "$f"; then
        local t="$f.ccenv.tmp"
        awk 'NR==1 && /^[[:space:]]*{/ { sub(/{/, "{\"hasCompletedOnboarding\":true,"); print; next } { print }' "$f" > "$t" 2>/dev/null \
          && mv "$t" "$f" || rm -f "$t" 2>/dev/null
      fi
    else
      printf '{"hasCompletedOnboarding":true}\n' > "$f"
    fi
    chmod 600 "$f" 2>/dev/null || true
  fi
}

# ---- commands ----------------------------------------------------------------

cmd_create() {
  local name="" isolated=0 do_login=1 share_from="$BASE_CONFIG"
  local -a login_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --isolated)    isolated=1 ;;
      --no-login)    do_login=0 ;;
      --share-from)  shift; case "${1:-}" in -*|"") die "--share-from needs a directory" ;; esac; share_from="$1" ;;
      --email)       shift; login_args+=(--email "${1:-}") ;;
      --console|--sso|--claudeai) login_args+=("$1") ;;
      -*)            die "unknown option: $1" ;;
      *)             [ -z "$name" ] && name="$1" || die "unexpected argument: $1" ;;
    esac
    shift
  done
  validate_name "$name" || exit 1
  is_default "$name" && die "'$name' is reserved (it is your existing ~/.claude)"
  local dir; dir="$(profile_dir "$name")"
  [ -e "$dir" ] && die "profile already exists: $name"

  mkdir -p "$dir"
  chmod 700 "$CCENV_HOME" "$PROFILES_DIR" "$dir" 2>/dev/null || true

  if [ "$isolated" -eq 0 ] && [ -d "$share_from" ]; then
    seed_profile "$dir" "$share_from"
  fi
  mark_onboarded "$dir"
  ok "created ${B}$name${X}"

  if [ "$do_login" -eq 1 ]; then
    printf 'Sign in now? [Y/n] '
    local ans; read -r ans || ans="n"
    case "${ans:-y}" in
      n|N|no|NO) info "${D}later: ccenv login $name${X}" ;;
      *) cmd_login "$name" ${login_args[@]+"${login_args[@]}"} ;;
    esac
  fi
}

cmd_login() {
  local name="${1:-}"; shift || true
  local dir; dir="$(resolve_dir "$name")" || exit 1
  local rc=0
  if [ -z "$dir" ]; then
    env -u CLAUDE_CONFIG_DIR claude auth login "$@" || rc=$?
  else
    env CLAUDE_CONFIG_DIR="$dir" claude auth login "$@" || rc=$?
    # On success, skip the TUI's first-run onboarding so `claude` starts logged in.
    [ "$rc" -eq 0 ] && mark_onboarded "$dir"
  fi
  return "$rc"
}

cmd_logout() {
  local name="${1:-}"
  local dir; dir="$(resolve_dir "$name")" || exit 1
  local rc=0
  if [ -z "$dir" ]; then
    env -u CLAUDE_CONFIG_DIR claude auth logout || rc=$?
  else
    env CLAUDE_CONFIG_DIR="$dir" claude auth logout || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    err "logout failed for $name — stored credentials may remain"
    return 1
  fi
  ok "signed out $name"
}

cmd_run() {
  local name="${1:-}"; shift || true
  [ "${1:-}" = "--" ] && shift
  local dir; dir="$(resolve_dir "$name")" || exit 1
  if [ -z "$dir" ]; then
    exec env -u CLAUDE_CONFIG_DIR claude "$@"
  else
    exec env CLAUDE_CONFIG_DIR="$dir" claude "$@"
  fi
}

# Print one status row. Marks the profile active in the current shell.
# Optional $3 = precomputed status JSON (cmd_list fetches these in parallel).
print_row() {
  local name="$1" dir="$2"
  local json loggedIn email plan
  if [ $# -ge 3 ]; then json="$3"; else json="$(auth_status_json "$dir")"; fi
  loggedIn="$(printf '%s' "$json" | json_field loggedIn)"
  email="$(printf '%s' "$json" | json_field email)"
  plan="$(printf '%s' "$json" | json_field subscriptionType)"

  local active=" "
  local cur_profile="${CCENV_PROFILE:-default}"
  if [ "$name" = "$cur_profile" ]; then active="${C}●${X}"; fi

  local state
  if ! status_ok "$json"; then
    state="${D}unavailable${X}"
  elif [ "$loggedIn" = "true" ]; then
    state="${email:-?}${plan:+  ${D}$plan${X}}"
  else
    state="${D}not signed in${X}"
  fi
  printf '%b %s%-10s%s %s\n' "$active" "$B" "$name" "$X" "$state"
}

cmd_list() {
  local tmp; tmp="$(mktemp -d)" || return 1
  local -a names=() dirs=()
  local i=0 name dir
  # Fetch each profile's auth status in parallel, but CAP concurrency — each
  # `claude auth status` spawns the (large) CLI, so an unbounded fan-out over
  # hundreds of profiles could exhaust memory.
  local max=8
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    if is_default "$name"; then dir=""; else dir="$(profile_dir "$name")"; fi
    names[$i]="$name"; dirs[$i]="$dir"
    auth_status_json "$dir" > "$tmp/$i.json" 2>/dev/null &
    i=$((i + 1))
    # throttle: once `max` jobs are in flight, wait for one to finish
    # Throttle: wait for the oldest in-flight job. `wait -n` (bash 4.3+) would be
    # nicer but isn't portable, so wait on a specific PID — works on bash 3.2+.
    if [ "$(jobs -p | wc -l)" -ge "$max" ]; then wait "$(jobs -p | head -1)" 2>/dev/null || true; fi
  done < <(list_profiles)
  wait
  local n=0
  while [ "$n" -lt "$i" ]; do
    print_row "${names[$n]}" "${dirs[$n]}" "$(cat "$tmp/$n.json" 2>/dev/null)"
    n=$((n + 1))
  done
  rm -rf "$tmp"
  bg_refresh_version   # after the wait above, so it never blocks the listing
  note_update
}

cmd_status() {
  local name="${1:-}"
  if [ -z "$name" ]; then cmd_list; return; fi
  local dir; dir="$(resolve_dir "$name")" || exit 1
  if [ -z "$dir" ]; then
    env -u CLAUDE_CONFIG_DIR claude auth status --text 2>/dev/null
  else
    env CLAUDE_CONFIG_DIR="$dir" claude auth status --text 2>/dev/null
  fi
}

cmd_current() {
  printf '%s●%s %s%s%s\n' "$C" "$X" "$B" "${CCENV_PROFILE:-default}" "$X"
}

# Get/set/clear the standing default profile (auto-applied to new shells).
#   ccenv default            → show the current default
#   ccenv default <name>     → set it (profile must exist)
#   ccenv default --clear    → remove it
cmd_set_default() {
  local arg="${1:-}"
  case "$arg" in
    "")
      local cur; cur="$(read_default)"
      if [ -z "$cur" ]; then
        info "${D}no default set${X} — new shells start as ${B}default${X} (~/.claude)"
      else
        info "default profile: ${B}$cur${X}"
        [ -z "${CCENV_SHELL_LOADED:-}" ] && warn "shell integration not loaded — it won't auto-apply (run: ccenv doctor)"
      fi
      return 0 ;;
    --clear|clear|none|off)
      if [ -f "$DEFAULT_FILE" ]; then
        rm -f "$DEFAULT_FILE" && ok "cleared default — new shells start as ${B}default${X}"
      else
        info "${D}no default set${X}"
      fi
      return 0 ;;
    -*)
      die "unknown option: $arg  (usage: ccenv default [<name>|--clear])" ;;
  esac

  # Setting a default: the profile must resolve (default/main allowed).
  resolve_dir "$arg" >/dev/null || exit 1
  write_default "$arg" || die "could not write $DEFAULT_FILE"
  ok "default profile set to ${B}$arg${X}"
  if [ -n "${CCENV_SHELL_LOADED:-}" ]; then
    info "  ${D}new shells start as $arg; this shell updates now${X}"
  else
    info "  ${D}new shells start as $arg once shell integration is loaded (ccenv doctor)${X}"
  fi
}

# Pin a profile to a directory tree. A new shell whose cwd is at/under the pinned
# path auto-applies that profile (nearest pin wins), overriding the standing
# default. Directory defaults to the current one.
#   ccenv pin <profile> [dir]
cmd_pin() {
  local name="${1:-}" dir="${2:-$PWD}"
  [ -n "$name" ] || die "usage: ccenv pin <profile> [dir]"
  resolve_dir "$name" >/dev/null || exit 1     # profile must exist (default/main ok)
  local cdir; cdir="$(canon_dir "$dir")" || die "no such directory: $dir"
  # Upsert: drop any existing pin for this exact path, then append the new one.
  { [ -f "$PINS_FILE" ] && awk -F'\t' -v k="$cdir" '$1!=k' "$PINS_FILE"
    printf '%s\t%s\n' "$cdir" "$name"; } | write_pins || die "could not write $PINS_FILE"
  ok "pinned ${B}$name${X} → ${cdir/#$HOME/~}"
  [ -z "${CCENV_SHELL_LOADED:-}" ] && warn "shell integration not loaded — it won't auto-apply (run: ccenv doctor)"
  return 0
}

# Remove the pin for a directory (defaults to the current one).
#   ccenv unpin [dir]
cmd_unpin() {
  local dir="${1:-$PWD}"
  local cdir; cdir="$(canon_dir "$dir")" || die "no such directory: $dir"
  if [ ! -f "$PINS_FILE" ] || [ -z "$(pin_lookup "$cdir")" ]; then
    info "${D}no pin for ${cdir/#$HOME/~}${X}"; return 0
  fi
  awk -F'\t' -v k="$cdir" '$1!=k' "$PINS_FILE" | write_pins || die "could not write $PINS_FILE"
  ok "unpinned ${cdir/#$HOME/~}"
}

# List every directory pin, flagging stale rows (profile or directory gone).
#   ccenv pins
cmd_pins() {
  if [ ! -s "$PINS_FILE" ]; then
    info "${D}no directory pins${X} — attach one with: ccenv pin <profile> [dir]"; return 0
  fi
  info "${B}directory pins${X}"
  local path name flag
  sort "$PINS_FILE" | while IFS="$(printf '\t')" read -r path name; do
    [ -n "$path" ] || continue
    flag=""
    resolve_dir "$name" >/dev/null 2>&1 || flag="  ${Y}(profile '$name' missing)${X}"
    [ -d "$path" ] || flag="$flag  ${Y}(dir gone)${X}"
    printf '  %s%s%s → %s%s%s%s\n' "$C" "${path/#$HOME/~}" "$X" "$B" "$name" "$X" "$flag"
  done
}

# Internal (used by the shell startup block): decide which profile a new shell
# starting at PATH should adopt. Precedence: nearest directory pin > standing
# default. Prints "<name>\t<dir>" (dir empty = default/ambient ~/.claude), or
# nothing when there is nothing to apply. Always exit 0.
cmd_resolve_auto() {
  local start; start="$(canon_dir "${1:-$PWD}")" || start=""
  local name=""
  [ -n "$start" ] && name="$(nearest_pin "$start")"
  local from_pin=1
  [ -z "$name" ] && { name="$(read_default)"; from_pin=0; }
  [ -n "$name" ] || return 0              # nothing configured
  local dir
  if ! dir="$(resolve_dir "$name" 2>/dev/null)"; then
    # Stale pin → fall back to the standing default; stale default → give up.
    [ "$from_pin" -eq 1 ] || return 0
    name="$(read_default)"; [ -n "$name" ] || return 0
    dir="$(resolve_dir "$name" 2>/dev/null)" || return 0
  fi
  printf '%s\t%s' "$name" "$dir"
}

cmd_remove() {
  local name="" keep=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-creds) keep=1 ;;
      -y|--yes)     yes=1 ;;
      -*)           die "unknown option: $1" ;;
      *)            [ -z "$name" ] && name="$1" || die "unexpected argument: $1" ;;
    esac
    shift
  done
  validate_name "$name" || exit 1
  is_default "$name" && die "refusing to remove the default profile (~/.claude)"
  # Refuse if the profiles dir (or the profile itself) is a symlink — otherwise a
  # planted symlink could redirect rm -rf outside the intended tree.
  [ -L "$PROFILES_DIR" ] && die "refusing: $PROFILES_DIR is a symlink"
  local dir; dir="$(profile_dir "$name")"
  [ -L "$dir" ] && die "refusing: profile '$name' is a symlink"
  [ -d "$dir" ] || die "no such profile: $name"

  # Safety: the resolved real path MUST live under the real PROFILES_DIR. Resolve
  # BOTH sides (macOS /var → /private/var). We already rejected symlinked
  # PROFILES_DIR/profile above, so realpath can't be redirected here.
  local real real_profiles
  real="$(cd "$dir" 2>/dev/null && pwd -P)" || die "cannot resolve $dir"
  real_profiles="$(cd "$PROFILES_DIR" 2>/dev/null && pwd -P)" || die "cannot resolve $PROFILES_DIR"
  case "$real/" in
    "$real_profiles"/?*) : ;;
    *) die "refusing to delete path outside $real_profiles: $real" ;;
  esac

  if [ "$yes" -ne 1 ]; then
    printf 'Remove profile %s%s%s and ' "$B" "$name" "$X"
    [ "$keep" -eq 1 ] && printf 'KEEP its login? ' || printf 'sign it out (clear stored credentials)? '
    printf '[y/N] '
    local ans; read -r ans || ans="n"
    case "${ans:-n}" in y|Y|yes|YES) : ;; *) info "Aborted."; return 0 ;; esac
  fi

  if [ "$keep" -ne 1 ]; then
    env CLAUDE_CONFIG_DIR="$dir" claude auth logout >/dev/null 2>&1 \
      && ok "cleared stored credentials for $name" \
      || err "could not run auth logout (continuing to delete files)"
  fi
  rm -rf "$real"
  ok "removed profile $name"

  # Drop a dangling default so new shells don't try to resolve a gone profile.
  if [ "$(read_default)" = "$name" ]; then
    rm -f "$DEFAULT_FILE" && info "  ${D}was the default — cleared it${X}"
  fi

  # Drop any directory pins that referenced the removed profile.
  if [ -f "$PINS_FILE" ] && awk -F'\t' -v n="$name" '$2==n{f=1} END{exit !f}' "$PINS_FILE"; then
    awk -F'\t' -v n="$name" '$2!=n' "$PINS_FILE" | write_pins
    info "  ${D}removed directory pins for $name${X}"
  fi
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  validate_name "$old" || exit 1
  validate_name "$new" || exit 1
  is_default "$old" && die "cannot rename the default profile"
  is_default "$new" && die "'$new' is reserved"
  local od nd; od="$(profile_dir "$old")"; nd="$(profile_dir "$new")"
  [ -d "$od" ] || die "no such profile: $old"
  [ -e "$nd" ] && die "target already exists: $new"
  mv "$od" "$nd"
  # Follow the rename so a standing default keeps pointing at the same profile.
  if [ "$(read_default)" = "$old" ]; then
    write_default "$new" && info "  ${D}default updated: $old → $new${X}"
  fi
  # Follow the rename in the directory pins too.
  if [ -f "$PINS_FILE" ] && awk -F'\t' -v o="$old" '$2==o{f=1} END{exit !f}' "$PINS_FILE"; then
    awk -F'\t' -v o="$old" -v n="$new" 'BEGIN{OFS="\t"} $2==o{$2=n} 1' "$PINS_FILE" | write_pins
    info "  ${D}directory pins updated: $old → $new${X}"
  fi
  ok "renamed $old → $new  ${D}(re-login needed: ccenv login $new)${X}"
}

cmd_sync() {
  local name="${1:-}" share_from="${2:-$BASE_CONFIG}"
  local dir; dir="$(resolve_dir "$name")" || exit 1
  [ -z "$dir" ] && die "'default' is your base config — nothing to sync into it"
  [ -d "$share_from" ] || die "base config not found: $share_from"
  local asset
  for asset in "${SHARED_COPY[@]}"; do
    if [ -f "$share_from/$asset" ]; then
      rm -f "$dir/$asset"   # drop any old symlink/copy first (symlink→real copy)
      cp "$share_from/$asset" "$dir/$asset"
      chmod 600 "$dir/$asset" 2>/dev/null || true
    fi
  done
  # Re-link any shared assets that are missing (e.g. a plugin dir added later).
  for asset in "${SHARED_SYMLINK[@]}"; do
    if [ -e "$share_from/$asset" ] && [ ! -e "$dir/$asset" ]; then
      ln -s "$share_from/$asset" "$dir/$asset" 2>/dev/null || cp -R "$share_from/$asset" "$dir/$asset"
    fi
  done
  mark_onboarded "$dir"   # repair profiles created before onboarding was set
  ok "synced $name"
}

cmd_doctor() {
  local problems=0
  info "${B}ccenv doctor${X}"

  if command -v claude >/dev/null 2>&1; then
    ok "claude CLI: $(claude --version 2>/dev/null | head -1)"
  else
    err "claude CLI not found in PATH"; problems=$((problems+1))
  fi

  case "$(uname -s 2>/dev/null)" in
    Darwin)
      if command -v security >/dev/null 2>&1; then
        ok "credential store: macOS Keychain (managed by claude)"
      else
        err "'security' not found — Keychain unavailable"; problems=$((problems+1))
      fi ;;
    *)
      ok "credential store: per-profile credentials file (managed by claude)" ;;
  esac

  if [ -d "$BASE_CONFIG" ]; then ok "base config: ${BASE_CONFIG/#$HOME/~}"; else err "base config missing: $BASE_CONFIG"; problems=$((problems+1)); fi

  # shell integration loaded?
  if [ -n "${CCENV_SHELL_LOADED:-}" ]; then
    ok "shell integration loaded (ccenv use/unuse active)"
  else
    err "shell integration NOT loaded → 'ccenv use' can't change this shell"
    info "    add to your shell rc:  ${C}source \"$(shell_file_path)\"${X}  (or run: ccenv shell-init)"
    problems=$((problems+1))
  fi

  # per-profile checks
  local name dir
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    if is_default "$name"; then dir=""; else dir="$(profile_dir "$name")"; fi
    local json loggedIn email
    json="$(auth_status_json "$dir")"
    loggedIn="$(printf '%s' "$json" | json_field loggedIn)"
    email="$(printf '%s' "$json" | json_field email)"
    if ! status_ok "$json"; then
      err "profile '$name' status unavailable (claude returned no JSON)"; problems=$((problems+1))
    elif [ "$loggedIn" = "true" ]; then
      ok "profile '$name' signed in (${email:-?})"
    else
      info "  ${Y}•${X} profile '$name' logged out  ${D}(ccenv login $name)${X}"
    fi
    # broken symlinks?
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      local bad; bad="$(find "$dir" -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null)"
      [ -n "$bad" ] && { err "profile '$name' has broken symlink(s): $bad"; problems=$((problems+1)); }
      # legacy: mutable config symlinked (racy under concurrent use) — should be a copy
      local m
      for m in "${SHARED_COPY[@]}"; do
        if [ -L "$dir/$m" ]; then
          info "  ${Y}•${X} profile '$name' has symlinked $m (shared/racy) — run ${C}ccenv sync $name${X} to isolate it"
        fi
      done
    fi
  done < <(list_profiles)

  # standing default: report it, and flag it if it points at a gone profile.
  local def; def="$(read_default)"
  if [ -n "$def" ]; then
    if resolve_dir "$def" >/dev/null 2>&1; then
      ok "default profile: $def (new shells auto-use it)"
    else
      err "default profile '$def' no longer exists — clear it: ccenv default --clear"; problems=$((problems+1))
    fi
  fi

  # directory pins: report count and flag any that point at a gone profile.
  if [ -s "$PINS_FILE" ]; then
    local pcount ppath pname
    pcount="$(grep -c . "$PINS_FILE" 2>/dev/null || echo 0)"
    ok "directory pins: $pcount (ccenv pins)"
    while IFS="$(printf '\t')" read -r ppath pname; do
      [ -n "$ppath" ] || continue
      if ! resolve_dir "$pname" >/dev/null 2>&1; then
        err "  pin ${ppath/#$HOME/~} → '$pname' no longer exists — clear it: ccenv unpin ${ppath/#$HOME/~}"; problems=$((problems+1))
      elif [ ! -d "$ppath" ]; then
        info "  ${Y}•${X} pin dir ${ppath/#$HOME/~} is gone (profile $pname)"
      fi
    done < "$PINS_FILE"
  fi

  info ""
  if [ "$problems" -eq 0 ]; then ok "all good"; else err "$problems issue(s) found"; fi
  return 0
}

# Absolute path of the ccenv binary that is currently running.
self_path() {
  local s="${BASH_SOURCE[0]:-$0}"
  case "$s" in
    */*) : ;;                                   # already a path
    *)   s="$(command -v "$s" 2>/dev/null)" || return 1 ;;  # bare name → resolve on PATH
  esac
  # Absolutize the directory (pwd -P resolves the DIR's symlinks) but keep the
  # basename so a symlinked install is still detected as a symlink by the caller.
  local d; d="$(cd "$(dirname "$s")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s' "$d" "$(basename "$s")"
}

# Extract CCENV_VERSION="x.y.z" from a ccenv script file.
version_of() { grep -m1 'CCENV_VERSION=' "$1" 2>/dev/null | sed -E 's/.*CCENV_VERSION="?([^"]*)"?.*/\1/'; }

# ---- update notice -----------------------------------------------------------
# Compare two dotted versions numerically. Prints gt|lt|eq for "$1 vs $2".
# Pure awk (portable across BSD/GNU); ignores any non-numeric pre-release suffix.
ver_cmp() {
  awk -v a="$1" -v b="$2" 'BEGIN{
    na=split(a,A,"."); nb=split(b,B,"."); m=(na>nb)?na:nb
    for(i=1;i<=m;i++){ x=(i<=na)?A[i]+0:0; y=(i<=nb)?B[i]+0:0
      if(x>y){print "gt"; exit} if(x<y){print "lt"; exit} }
    print "eq" }'
}

# Print a one-line "update available" notice if the cached latest version is
# newer than the running one. Pure local read — no network, safe to call often.
note_update() {
  [ -n "${CCENV_NO_UPDATE_CHECK:-}" ] && return 0
  [ -f "$UPDATE_CACHE" ] || return 0
  local latest; latest="$(cut -f2 "$UPDATE_CACHE" 2>/dev/null)"
  case "$latest" in [0-9]*.[0-9]*) : ;; *) return 0 ;; esac
  if [ "$(ver_cmp "$latest" "$CCENV_VERSION")" = "gt" ]; then
    printf '%s!%s update available: %sv%s%s  %s(run: ccenv update)%s\n' \
      "$Y" "$X" "$B" "$latest" "$X" "$D" "$X"
  fi
}

# Kick off a throttled, DETACHED version check. Never blocks the command the
# user ran, never runs on the shell-startup path (only cmd_help / cmd_list call
# it), and fetches the tiny /version file at most once per 24h.
bg_refresh_version() {
  [ -n "${CCENV_NO_UPDATE_CHECK:-}" ] && return 0
  local now last=0
  now="$(date +%s 2>/dev/null)" || return 0
  [ -f "$UPDATE_CACHE" ] && last="$(cut -f1 "$UPDATE_CACHE" 2>/dev/null)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ $(( now - last )) -lt 86400 ] && return 0
  local base="${CCENV_BASE_URL:-https://ccenv.dev}"
  ( # bounded fetch; always restamp the timestamp so an offline box doesn't retry
    # every invocation. Keep the previously-known latest if this fetch fails.
    tmp="$(mktemp "$UPDATE_CACHE.XXXXXX")" 2>/dev/null || exit 0
    v=""
    if command -v curl >/dev/null 2>&1; then
      v="$(curl -fsSL -m 3 "$base/version" 2>/dev/null | head -n1 | tr -d '[:space:]')"
    elif command -v wget >/dev/null 2>&1; then
      v="$(wget -q --timeout=3 -O - "$base/version" 2>/dev/null | head -n1 | tr -d '[:space:]')"
    fi
    case "$v" in [0-9]*.[0-9]*) : ;; *) v="" ;; esac
    [ -z "$v" ] && [ -f "$UPDATE_CACHE" ] && v="$(cut -f2 "$UPDATE_CACHE" 2>/dev/null)"
    [ -z "$v" ] && v="$CCENV_VERSION"
    printf '%s\t%s\n' "$now" "$v" > "$tmp" && chmod 600 "$tmp" 2>/dev/null && mv "$tmp" "$UPDATE_CACHE" || rm -f "$tmp"
  ) >/dev/null 2>&1 &
}

# macOS bundle sibling: ccdesktop runs multiple Claude Desktop (the macOS app)
# accounts — the GUI counterpart to ccenv — and ships alongside it on macOS.
# This installs it next to the ccenv binary: backfilling it for existing users
# who predate the bundle, or refreshing it on a later update. Best-effort and
# non-fatal — a failure here never aborts an in-progress ccenv update. No-op off
# macOS (Claude Desktop is a macOS app; Linux/Windows have no Desktop client).
sync_ccdesktop() { # bindir baseurl
  [ "$(uname -s 2>/dev/null)" = "Darwin" ] || return 0
  local dir="$1" base="$2" desk="$1/ccdesktop" dtmp ev existed=0
  [ -d "$dir" ] && [ -w "$dir" ] || return 0
  [ -e "$desk" ] && existed=1
  ev="install"; [ "$existed" -eq 1 ] && ev="update"
  dtmp="$(mktemp "$desk.ccenv-update.XXXXXX" 2>/dev/null)" || return 0
  # Validate it looks like the real ccdesktop before trusting it (reject HTML
  # error pages / truncated bodies), mirroring the ccenv self-update check.
  if fetch "$base/bin/ccdesktop?e=$ev" "$dtmp" 2>/dev/null \
     && head -n1 "$dtmp" | grep -q '^#!' && grep -q 'CCDESK_VERSION=' "$dtmp"; then
    chmod +x "$dtmp" 2>/dev/null || true
    if mv "$dtmp" "$desk" 2>/dev/null; then
      if [ "$existed" -eq 1 ]; then info "  ${D}refreshed bundled ccdesktop${X}"
      else ok "installed ccdesktop → $desk  ${D}(run multiple Claude Desktop accounts)${X}"; fi
      return 0
    fi
  fi
  rm -f "$dtmp" 2>/dev/null
  return 0
}

# Update ccenv in place to the latest build published at CCENV_BASE_URL.
# ALWAYS fetches from the hosted build (ccenv.dev by default), for every install
# type. A clone install's PATH entry is a symlink into the repo; we replace that
# symlink with the downloaded copy — the repo working tree is left untouched, and
# the running process keeps reading its own inode, so self-replacement is safe.
cmd_update() {
  local base="${CCENV_BASE_URL:-https://ccenv.dev}" force=0 check=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --check)  check=1 ;;
      --force)  force=1 ;;
      *)        die "unknown option: $1  (usage: ccenv update [--check] [--force])" ;;
    esac
    shift
  done

  local self; self="$(self_path)" || die "cannot locate the running ccenv binary to update"
  local dir; dir="$(dirname "$self")"
  [ -w "$dir" ] || die "cannot update: $dir is not writable (re-run the installer, or use sudo)"
  local was_link=0; [ -L "$self" ] && was_link=1

  # Fetch the latest binary into a temp file NEXT TO the target so the final
  # rename is atomic and stays on the same filesystem.
  local tmp; tmp="$(mktemp "$self.ccenv-update.XXXXXX")" || die "cannot create temp file in $dir"
  # No EXIT trap: $tmp is function-local and would be unbound (set -u) when the
  # trap fired at process exit. Clean up explicitly on every path instead.

  info "checking $base for the latest ccenv…"
  # Tag the fetch so the server can tell a real update from a mere --check.
  local ev="update"; [ "$check" -eq 1 ] && ev="check"
  fetch "$base/bin/ccenv?e=$ev" "$tmp" || { rm -f "$tmp"; die "download failed: $base/bin/ccenv"; }
  # Reject HTML error pages / truncated bodies before trusting the file.
  { head -n1 "$tmp" | grep -q '^#!' && grep -q 'CCENV_VERSION=' "$tmp"; } \
    || { rm -f "$tmp"; die "downloaded file doesn't look like ccenv — aborting (nothing changed)"; }

  local newver oldver; newver="$(version_of "$tmp")"; oldver="$CCENV_VERSION"
  if [ "$newver" = "$oldver" ] && [ "$force" -eq 0 ]; then
    rm -f "$tmp"
    # Backfill/refresh the bundled sibling — but NEVER on --check, which must stay
    # read-only (this branch precedes and shadows the --check early-return below).
    [ "$check" -eq 1 ] || sync_ccdesktop "$dir" "$base"
    ok "already up to date (v$oldver)"; return 0
  fi
  if [ "$check" -eq 1 ]; then
    rm -f "$tmp"; info "current v$oldver → available ${B}v$newver${X}   ${D}run: ccenv update${X}"; return 0
  fi

  # Preserve the existing binary's mode; guarantee it stays executable.
  local perm; perm="$(file_mode "$self")"; [ -n "$perm" ] && chmod "$perm" "$tmp" 2>/dev/null
  chmod +x "$tmp" 2>/dev/null || true
  # Atomic swap: rename replaces the directory entry with a NEW inode; the
  # currently-running process keeps reading the old inode, so this is safe. If
  # $self was a clone symlink, this replaces the link with the downloaded copy.
  mv "$tmp" "$self" || { rm -f "$tmp"; die "could not replace $self"; }
  [ "$was_link" -eq 1 ] && info "  ${D}was a clone symlink → now a standalone copy from ${base#https://} (repo left untouched)${X}"

  # Best-effort refresh of the installed shell snippet too (harmless if absent).
  if [ -f "$CCENV_HOME/shell/ccenv.sh" ]; then
    local stmp; stmp="$(mktemp "$CCENV_HOME/shell/ccenv.sh.XXXXXX" 2>/dev/null)" || stmp=""
    if [ -n "$stmp" ] && fetch "$base/shell/ccenv.sh" "$stmp" 2>/dev/null && grep -q 'CCENV_SHELL_LOADED' "$stmp"; then
      chmod 600 "$stmp" 2>/dev/null || true
      mv "$stmp" "$CCENV_HOME/shell/ccenv.sh" && info "  ${D}refreshed shell integration snippet${X}"
    else
      [ -n "$stmp" ] && rm -f "$stmp"
    fi
  fi

  sync_ccdesktop "$dir" "$base"   # keep the bundled macOS sibling in lockstep

  if [ "$newver" = "$oldver" ]; then ok "reinstalled ccenv v$newver"; else ok "updated ccenv v$oldver → ${B}v$newver${X}"; fi
  info "  ${D}restart open shells to pick up the refreshed integration${X}"
}

# Atomically strip ccenv-marked lines from an rc file (preserve mode; temp
# in the same dir so the final mv is atomic). Keep in sync with uninstall.sh.
prune_rc() {
  local rc="$1" tmp perm t hops=0
  grep -qF "# >>> ccenv " "$rc" 2>/dev/null || return 0
  # Follow a symlinked rc (stow/chezmoi dotfiles) to its physical file so the
  # atomic mv rewrites the target instead of replacing the user's symlink.
  while [ -L "$rc" ] && [ "$hops" -lt 10 ]; do
    t="$(readlink "$rc")" || break
    case "$t" in /*) rc="$t" ;; *) rc="$(dirname "$rc")/$t" ;; esac
    hops=$((hops + 1))
  done
  tmp="$(mktemp "${rc}.ccenv.XXXXXX")" || return 1
  grep -vF "# >>> ccenv " "$rc" > "$tmp" || true
  perm="$(file_mode "$rc")"; [ -n "$perm" ] && chmod "$perm" "$tmp" 2>/dev/null
  mv "$tmp" "$rc" && ok "removed ccenv lines from ${rc/#$HOME/~}"
  rm -f "$tmp" 2>/dev/null   # no-op after a successful mv; cleans up on failure
}

# Self-uninstall. The twin of the repo's uninstall.sh (keep the two in sync),
# but self-contained so it works even when the repo clone is gone or the binary
# was installed as a copy (Git Bash). Deleting the running script is safe: the
# whole file is parsed before main() runs, and on unix the inode outlives the
# unlink anyway. Profiles and logins are kept unless --purge.
cmd_uninstall() {
  local purge=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge)  purge=1 ;;
      -y|--yes) yes=1 ;;
      *)        die "unknown option: $1  (usage: ccenv uninstall [--purge] [-y])" ;;
    esac
    shift
  done

  if [ "$yes" -ne 1 ]; then
    if [ "$purge" -eq 1 ]; then
      printf 'Uninstall ccenv and %sDELETE ALL PROFILES%s (signs every account out)? [y/N] ' "$R" "$X"
    else
      printf 'Uninstall ccenv? Profiles at %s are kept. [y/N] ' "${PROFILES_DIR/#$HOME/~}"
    fi
    local ans; read -r ans || ans="n"
    case "${ans:-n}" in y|Y|yes|YES) : ;; *) info "Aborted."; return 2 ;; esac
  fi

  # Resolve where we run from: self_dir joins the bin-dir candidates (covers a
  # custom CCENV_BIN_DIR from install time), and the symlink target tells the
  # user where the repo clone lives so they can delete it themselves.
  local self self_dir="" target repo=""
  self="${BASH_SOURCE[0]:-$0}"
  self_dir="$(cd "$(dirname "$self")" 2>/dev/null && pwd -P)" || self_dir=""
  if [ -L "$self" ] && target="$(readlink "$self" 2>/dev/null)"; then
    case "$target" in /*) : ;; *) target="$(dirname "$self")/$target" ;; esac
    repo="$(cd "$(dirname "$target")/.." 2>/dev/null && pwd -P)" || repo=""
  elif [ -f "$self_dir/../install.sh" ] && [ -f "$self_dir/../shell/ccenv.sh" ]; then
    # invoked straight from a checkout (./bin/ccenv) — that IS the repo
    repo="$(cd "$self_dir/.." 2>/dev/null && pwd -P)" || repo=""
  fi

  # 1. remove the installed command from any dir the installer may have used.
  local d removed=0
  for d in "$self_dir" "${CCENV_BIN_DIR:-}" /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
    [ -n "$d" ] || continue
    if [ -L "$d/ccenv" ]; then
      rm -f "$d/ccenv" && ok "removed $d/ccenv" && removed=1
    elif [ -f "$d/ccenv" ] && grep -q 'CCENV_VERSION=' "$d/ccenv" 2>/dev/null; then
      # copy-mode install: only delete a file we can prove is ours — and never
      # a repo checkout's own bin/ccenv (e.g. ./bin/ccenv uninstall).
      if [ -f "$d/../install.sh" ] && [ -f "$d/../shell/ccenv.sh" ]; then continue; fi
      rm -f "$d/ccenv" && ok "removed $d/ccenv (copied binary)" && removed=1
    fi
    # Bundled macOS sibling: remove ccdesktop the same way (symlink, or a copy we
    # can prove is ours; never a repo checkout's own bin/ccdesktop).
    if [ -L "$d/ccdesktop" ]; then
      rm -f "$d/ccdesktop" && ok "removed $d/ccdesktop"
    elif [ -f "$d/ccdesktop" ] && grep -q 'CCDESK_VERSION=' "$d/ccdesktop" 2>/dev/null; then
      if [ ! -f "$d/../install.sh" ] || [ ! -f "$d/../shell/ccenv.sh" ]; then
        rm -f "$d/ccdesktop" && ok "removed $d/ccdesktop (copied binary)"
      fi
    fi
  done
  [ "$removed" -eq 0 ] && warn "no installed ccenv found in the usual bin dirs"

  # 2. strip the PATH / shell-integration lines from the rc files.
  local rc
  while IFS= read -r rc; do
    [ -f "$rc" ] && prune_rc "$rc"
  done < <(printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.zshrc" "$HOME/.bashrc" | sort -u)

  # 3. remove the installed shell snippet (orphaned once the rc line is gone).
  if [ -f "$CCENV_HOME/shell/ccenv.sh" ]; then
    rm -f "$CCENV_HOME/shell/ccenv.sh" && ok "removed installed shell snippet"
    rmdir "$CCENV_HOME/shell" 2>/dev/null || true
  fi

  # 4. profiles: keep by default, sign out + delete with --purge.
  if [ "$purge" -eq 1 ]; then
    local failures="" p
    if [ -d "$PROFILES_DIR" ]; then
      if ! command -v claude >/dev/null 2>&1; then
        warn "claude not on PATH — cannot sign profiles out; stored credentials may remain"
      else
        for p in "$PROFILES_DIR"/*/; do
          [ -d "$p" ] || continue
          if env CLAUDE_CONFIG_DIR="${p%/}" claude auth logout >/dev/null 2>&1; then
            ok "signed out $(basename "$p")"
          else
            failures="$failures $(basename "$p")"
          fi
        done
      fi
    fi
    [ -n "$failures" ] && warn "logout failed for:$failures — stored credentials may remain (macOS: remove 'Claude Code-credentials*' from Keychain Access; Linux/Windows: clear with 'claude auth logout')"
    rm -rf "$CCENV_HOME"   # guarded at startup: real dir under $HOME, no '..'
    ok "deleted ${CCENV_HOME/#$HOME/~} (all profiles)"
  else
    warn "profiles kept at ${PROFILES_DIR/#$HOME/~} — sign out with 'claude auth logout' (CLAUDE_CONFIG_DIR=<profile dir>) before deleting them by hand, or reinstall and run 'ccenv uninstall --purge'"
  fi

  [ -n "$repo" ] && info "  ${D}repo clone remains at ${repo/#$HOME/~} — delete it when you're done${X}"
  info "  ${D}open shells: restart them (or: unset -f ccenv; unset CLAUDE_CONFIG_DIR CCENV_PROFILE)${X}"
  ok "uninstalled"
}

shell_file_path() {
  # Best guess at the installed shell snippet location.
  local self; self="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
  printf '%s/../shell/ccenv.sh' "$self"
}

cmd_shell_init() {
  # Emit the shell function so users can `eval "$(ccenv shell-init)"` or
  # source the static file. Keep in sync with shell/ccenv.sh.
  cat <<'SNIPPET'
# ccenv shell integration
__ccenv_autoapply() {
  [ -z "${CCENV_PROFILE:-}" ] || [ -n "${CCENV_AUTO:-}" ] || return 0
  local __a="" __n __d
  if [ -e "${CCENV_HOME:-$HOME/.ccenv}/default" ] || [ -e "${CCENV_HOME:-$HOME/.ccenv}/pins" ]; then
    __a="$(command ccenv resolve-auto "$PWD" 2>/dev/null)"
  fi
  # Require a NAME<tab>DIR shape; ignore tab-less output (e.g. from an older
  # binary on PATH) so it can't set a bogus profile.
  if [ -n "$__a" ] && [ "$__a" != "${__a#*$'\t'}" ]; then
    __n="${__a%%$'\t'*}"; __d="${__a#*$'\t'}"
    if [ -n "$__d" ]; then export CLAUDE_CONFIG_DIR="$__d"; else unset CLAUDE_CONFIG_DIR; fi
    export CCENV_PROFILE="$__n" CCENV_AUTO=1
  elif [ -n "${CCENV_AUTO:-}" ]; then
    unset CLAUDE_CONFIG_DIR CCENV_PROFILE CCENV_AUTO
  fi
}
ccenv() {
  case "${1:-}" in
    use)
      if [ -z "${2:-}" ]; then command ccenv help; return 2; fi
      local __d
      if ! __d="$(command ccenv resolve "$2")"; then return 1; fi
      if [ -z "$__d" ]; then unset CLAUDE_CONFIG_DIR; else export CLAUDE_CONFIG_DIR="$__d"; fi
      export CCENV_PROFILE="$2"
      unset CCENV_AUTO                # explicit choice — never auto-re-resolved
      command ccenv current
      ;;
    unuse)
      unset CLAUDE_CONFIG_DIR CCENV_PROFILE CCENV_AUTO
      command ccenv current
      ;;
    default|set-default|setdefault)
      command ccenv "$@" || return $?
      # Setting a default also switches THIS shell now (skip show/clear forms).
      case "${2:-}" in
        ""|--clear|clear|none|off|-*) : ;;
        *) ccenv use "$2" ;;
      esac
      ;;
    pin|unpin)
      # Persist the pin, then reflect it in THIS shell now (new terminals do this
      # at startup). Never overrides an explicit `ccenv use`.
      command ccenv "$@" || return $?
      __ccenv_autoapply
      command ccenv current
      ;;
    uninstall)
      command ccenv "$@"
      local __rc=$?
      case "$__rc" in
        126|127) echo "ccenv binary already gone — cleared this shell's integration (repo leftovers: ./uninstall.sh)" >&2 ;;
        0) : ;;
        *) return "$__rc" ;;
      esac
      # Remove the directory-change hook before dropping the functions it calls.
      if [ -n "${ZSH_VERSION:-}" ]; then
        autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook -d chpwd __ccenv_autoapply 2>/dev/null
      elif [ -n "${BASH_VERSION:-}" ]; then
        PROMPT_COMMAND="${PROMPT_COMMAND//__ccenv_pwd_hook;/}"
        PROMPT_COMMAND="${PROMPT_COMMAND//__ccenv_pwd_hook/}"
        unset -f __ccenv_pwd_hook 2>/dev/null
        unset __CCENV_LAST_PWD
      fi
      unset CLAUDE_CONFIG_DIR CCENV_PROFILE CCENV_AUTO CCENV_SHELL_LOADED
      unset -f ccenv __ccenv_autoapply
      ;;
    *) command ccenv "$@" ;;
  esac
}
export CCENV_SHELL_LOADED=1

# Re-apply on directory change: a pin must take effect when you `cd` INTO a
# pinned directory, not only when a shell STARTS there. zsh fires chpwd on every
# cd; bash has no native equivalent, so we guard a PROMPT_COMMAND entry on $PWD
# actually changing.
if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook chpwd __ccenv_autoapply
elif [ -n "${BASH_VERSION:-}" ]; then
  __ccenv_pwd_hook() {
    [ "${__CCENV_LAST_PWD:-}" = "$PWD" ] && return 0
    __CCENV_LAST_PWD="$PWD"; __ccenv_autoapply
  }
  case "${PROMPT_COMMAND:-}" in
    *__ccenv_pwd_hook*) : ;;
    *) PROMPT_COMMAND="__ccenv_pwd_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
  esac
fi

# Auto-apply the pin/default for this shell's starting directory. Re-resolves
# when the shell has no profile yet, or when an inherited profile was itself
# auto-applied, so an auto profile never leaks out of the directory it was set
# in through an inherited environment (a new tab / editor terminal / tmux pane).
__ccenv_autoapply
SNIPPET
}

cmd_help() {
  bg_refresh_version
  if [ "${1:-}" = "full" ] || [ "${1:-}" = "-v" ] || [ "${1:-}" = "--verbose" ]; then cmd_help_full; return; fi
  note_update
  cat <<EOF
${B}ccenv${X} ${D}v${CCENV_VERSION}${X} — run multiple Claude Code accounts

  ${C}list${X}                     accounts + who's signed in
  ${C}use${X} <name> / ${C}unuse${X}       switch this shell  ${D}(needs integration)${X}
  ${C}default${X} [name]           auto-use <name> in every new shell
  ${C}pin${X} <name> [dir]         auto-use <name> in a folder + its subdirs
  ${C}unpin${X} [dir] / ${C}pins${X}      remove a folder pin / list pins
  ${C}run${X} <name> [-- args]     launch claude as <name>
  ${C}create${X} <name>            add an account, then sign in
  ${C}login${X} / ${C}logout${X} <name>    sign in / out
  ${C}status${X} [name]            auth details
  ${C}sync${X} <name>              refresh shared config into a profile
  ${C}remove${X} / ${C}rename${X} <name>   delete / rename
  ${C}doctor${X}                   health check
  ${C}update${X}                   fetch the latest ccenv from ccenv.dev
  ${C}uninstall${X} [--purge]      remove ccenv itself  ${D}(--purge: profiles too)${X}

  ${D}two at once →  A: ccenv use work   B: ccenv use personal${X}
  ${D}ccenv help full → options, security, what's shared${X}
EOF
}

cmd_help_full() {
  note_update
  cat <<EOF
${B}ccenv${X} ${D}v${CCENV_VERSION}${X} — multiple Claude Code accounts, secure & concurrent

${B}CREATE OPTIONS${X}
  --isolated                 Don't share any config (clean profile)
  --no-login                 Create only; sign in later
  --email <addr>             Pre-fill email on the login page
  --share-from <dir>         Inherit config from <dir> instead of ~/.claude
  --console | --sso | --claudeai   Login mode passthrough to 'claude auth login'

${B}REMOVE OPTIONS${X}
  -y, --yes                  Don't prompt for confirmation
  --keep-creds               Delete files but KEEP the stored login. A later
                             'create <same-name>' reuses it (the credential store
                             is keyed by the profile's path).

${B}UPDATE OPTIONS${X}
  ccenv update               Fetch the latest build from ccenv.dev and swap it in
                             atomically. A clone install's symlink is replaced with
                             the downloaded copy (the repo is left untouched).
  --check                    Report the available version without changing anything
  --force                    Reinstall even if already on the latest version
                             (origin: CCENV_BASE_URL, default https://ccenv.dev)
  ccenv list / help          Show an "update available" notice when a newer build
                             exists (checked in the background at most once/day).
                             Set CCENV_NO_UPDATE_CHECK=1 to disable that check.

${B}UNINSTALL OPTIONS${X}
  ccenv uninstall         Remove the installed command, rc lines, and shell
                             snippet. Profiles and logins are KEPT.
  --purge                    Also sign out every profile and delete ~/.ccenv
  -y, --yes                  Don't prompt for confirmation
                             (repo fallback: ./uninstall.sh [--purge])

${B}DEFAULT PROFILE${X}
  ccenv default <name>       Auto-use <name> in every NEW shell (saved to
                             ${DEFAULT_FILE/#$HOME/~}). No more 'ccenv use' each terminal.
  ccenv default             Show the current default
  ccenv default --clear      Back to 'default' (~/.claude) for new shells
                             An explicit 'ccenv use'/'unuse' still overrides it
                             per-shell; subshells inherit the parent's choice.

${B}DIRECTORY PINS${X}
  ccenv pin <name> [dir]     Attach <name> to a folder (default: the current
                             one). A NEW terminal opened at/under it auto-uses
                             <name>. Saved to ${PINS_FILE/#$HOME/~}.
  ccenv unpin [dir]          Remove the pin for a folder
  ccenv pins                 List every pin (flags stale ones)
                             Nearest pin wins over ancestors; a pin beats the
                             standing default; an explicit 'ccenv use' still wins.
                             Applied at new-shell startup only (not on cd).

${B}SHARED vs PER-PROFILE${X}
  Symlinked (shared):   plugins, skills, commands, hooks, CLAUDE.md
  Copied per profile:   settings.json, settings.local.json, mcp_config.json
                        (concurrent accounts never race; 'ccenv sync' re-copies)
  Fresh per profile:    sessions, projects, history, credentials
  Custom hooks run with CLAUDE_CONFIG_DIR set to the active profile — keep them
  account-agnostic if you run accounts concurrently.

${B}CLAUDE DESKTOP (macOS)${X}
  ccdesktop is bundled on macOS — the same idea for the Claude Desktop app: run
  multiple accounts at once, each account in its own window. 'ccenv update' keeps
  it current (and backfills it if you predate the bundle). See 'ccdesktop help'.

${B}SECURITY${X}
  Tokens stay in the OS credential store (macOS Keychain, or a per-profile
  credentials file on Linux/Windows), managed by 'claude auth'. ccenv stores
  ZERO secrets itself. Profiles under ${PROFILES_DIR/#$HOME/~} (0700).
  'default' = your existing ~/.claude (nothing to migrate).
EOF
}

# ---- dispatch ----------------------------------------------------------------
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list|ls)            cmd_list "$@" ;;
    create|new)         cmd_create "$@" ;;
    login)              cmd_login "$@" ;;
    logout)             cmd_logout "$@" ;;
    run|launch|exec)    cmd_run "$@" ;;
    use|unuse)          die "'$cmd' needs shell integration → restart your shell or re-source your rc (or: ccenv shell-init)" ;;
    current|active)     cmd_current "$@" ;;
    default|set-default|setdefault) cmd_set_default "$@" ;;
    pin)                cmd_pin "$@" ;;
    unpin)              cmd_unpin "$@" ;;
    pins)               cmd_pins "$@" ;;
    status|st)          cmd_status "$@" ;;
    sync)               cmd_sync "$@" ;;
    remove|rm|delete)   cmd_remove "$@" ;;
    rename|mv)          cmd_rename "$@" ;;
    resolve)            resolve_dir "${1:-}" ;;   # internal: used by shell fn
    resolve-auto)       cmd_resolve_auto "${1:-}" ;;   # internal: used by shell fn
    doctor)             cmd_doctor "$@" ;;
    update|upgrade)     cmd_update "$@" ;;
    uninstall)          cmd_uninstall "$@" ;;
    shell-init)         cmd_shell_init "$@" ;;
    version|--version|-V) printf 'ccenv %s\n' "$CCENV_VERSION" ;;
    help|-h|--help)     cmd_help "$@" ;;
    *)                  err "unknown command: $cmd"; info "run 'ccenv help'"; exit 1 ;;
  esac
}

main "$@"
